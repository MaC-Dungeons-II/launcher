-static AudioComponentInstance get_audiounit(EDataFlow dataflow, AudioDeviceID adevid)
+static AudioDeviceID default_output_device(void)
+{
+    const AudioObjectPropertyAddress addr =
+    {
+        .mScope = kAudioObjectPropertyScopeGlobal,
+        .mElement = kAudioObjectPropertyElementMain,
+        .mSelector = kAudioHardwarePropertyDefaultOutputDevice,
+    };
+    AudioDeviceID id;
+    UInt32 size = sizeof(id);
+
+    if(AudioObjectGetPropertyData(kAudioObjectSystemObject, &addr, 0, NULL, &size, &id) != noErr)
+        return kAudioObjectUnknown;
+    return id;
+}
+
+/* The device a stream is playing on right now. */
+static AudioDeviceID stream_device(const struct coreaudio_stream *stream)
+{
+    AudioDeviceID id;
+
+    if(stream->follow_default && (id = default_output_device()) != kAudioObjectUnknown)
+        return id;
+    return stream->dev_id;
+}
+
+/* follow_default: a render unit that moves to the new default output when
+ * macOS switches it (headphones or a Bluetooth device connecting, the
+ * current device going away) instead of staying on adevid. */
+static AudioComponentInstance get_audiounit(EDataFlow dataflow, AudioDeviceID adevid, BOOL follow_default)
 {
     AudioComponentInstance unit;
     AudioComponent comp;
