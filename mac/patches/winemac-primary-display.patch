+/* M(a)C Dungeons II: MACD2_PRIMARY_DISPLAY=<CGDirectDisplayID> reports that
+ * display as Windows' primary monitor instead of the menu-bar display, so a
+ * game opens (and goes fullscreen) there. Monitor coordinates stay relative to
+ * the menu-bar display; win32u uses the primary's real rectangle. Falls back to
+ * the menu-bar display if the requested one is offline or mirrored. */
+static BOOL display_is_primary(CGDirectDisplayID display_id, const CGDirectDisplayID *display_ids, uint32_t count)
+{
+    const char *env = getenv("MACD2_PRIMARY_DISPLAY");
+    if (env && *env)
+    {
+        CGDirectDisplayID wanted = (CGDirectDisplayID)strtoul(env, NULL, 10);
+        uint32_t i;
+        for (i = 0; i < count; i++)
+            if (display_ids[i] == wanted && CGDisplayMirrorsDisplay(wanted) == kCGNullDirectDisplay)
+                return display_id == wanted;
+    }
+    return CGDisplayIsMain(display_id);
+}
